## Copie este arquivo para `.env` e preencha os valores.
## Nunca commite seu `.env` com credenciais reais.

# RPC do bitcoind (regtest padrão)
RPC_URL=http://127.0.0.1:18443

# Credenciais RPC (bitcoin.conf: rpcuser/rpcpassword)
RPC_USER=usuario
RPC_PASS=senha

# Network do endereço: regtest | testnet | mainnet
NETWORK=regtest

# Endereço que receberá a coinbase (ex: retornado por `bitcoin-cli -regtest getnewaddress "" bech32`)
PAYOUT_ADDRESS=bcrt1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq

# Quantos nonces tentar antes de pedir um novo template
MAX_TRIES=2000000

# A cada quantos hashes imprimir o hashrate no terminal (0 desliga)
REPORT_EVERY=200000
